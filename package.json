{
  "name": "dsh-qwenpaw-bridge",
  "version": "0.2.1",
  "description": "DSH bundle plugin that upgrades the ACP profile for QwenPaw: live assistant streaming, hot-switchable permission presets, and a one-shot model catalog in _meta.qwenpaw.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BillYuan01/dsh-qwenpaw-bridge.git"
  },
  "homepage": "https://github.com/BillYuan01/dsh-qwenpaw-bridge#readme",
  "bugs": {
    "url": "https://github.com/BillYuan01/dsh-qwenpaw-bridge/issues"
  },
  "scripts": {
    "test": "node --test test/protocol.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "acp",
    "qwenpaw"
  ],
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-acp": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
